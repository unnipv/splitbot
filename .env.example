# ── Splitwise (OAuth app from https://secure.splitwise.com/apps) ──
SPLITWISE_CONSUMER_KEY=
SPLITWISE_CONSUMER_SECRET=
# Must match the callback URL registered on the Splitwise app
SPLITWISE_REDIRECT_URI=http://localhost:3000/api/splitwise/callback

# ── LLM providers (add keys for the ones you use) ──
OPENROUTER_API_KEY=
GROQ_API_KEY=
# GEMINI_API_KEY= / DEEPSEEK_API_KEY= / CEREBRAS_API_KEY=
# SARVAM_API_KEY=   (Indic-language models; used for Manglish roasts when set)

# Ordered "provider:model[@effort]" lists; each falls back to the next on quota/outage/bad reply.
# Defaults (with an OpenRouter key): DeepSeek V4.1 Flash → Qwen3.8 Max → Groq gpt-oss-120b@high → gpt-oss-20b@high
# AGENT_MODELS=openrouter:deepseek/deepseek-v4.1-flash,openrouter:qwen/qwen3.8-max-0902,groq:openai/gpt-oss-120b@high
# VISION_MODELS=openrouter:deepseek/deepseek-v4.1-flash,openrouter:qwen/qwen3-vl-235b-a22b-instruct,groq:qwen/qwen3.8-27b
# "#en" = mostly-English roast prompt for that model (default: Manglish)
# ROAST_MODELS=openrouter:deepseek/deepseek-v4.1-flash@medium,sarvam:sarvam-105b-conversations#en

# ── Bot ──
# Words that trigger the bot besides an @mention (comma separated, case-insensitive)
BOT_TRIGGERS=@splitbot,splitbot
DEFAULT_CURRENCY=INR
# auto: push clear expenses, draft ones the bot is unsure about · always: every expense is a draft until someone says yes/👍 · never: always push
CONFIRM_MODE=auto
# How off-topic messages are turned down: plain | manglish (Malayalam roasts, then the "last warning" sticker, then silence)
DENIAL_STYLE=plain
TIMEZONE=Asia/Kolkata
# Optional: your own WhatsApp number (digits, country code). Only this number can DM the bot.
OWNER_PHONE=

# ── Abuse guards (checked before any LLM call, so blocked messages cost nothing) ──
LIMIT_PER_PERSON_10MIN=6
LIMIT_PER_PERSON_DAY=30
LIMIT_PER_GROUP_DAY=100
MAX_MESSAGE_CHARS=600
# USD/day on OpenRouter; above it only free Groq models are used
DAILY_BUDGET_USD=0.5

# ── Dashboard ──
PORT=3000
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me
DATA_DIR=./data
