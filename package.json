{
  "name": "splitbot",
  "version": "0.1.0",
  "description": "WhatsApp group bot that logs trip expenses to Splitwise using an LLM",
  "main": "src/index.ts",
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "eval": "node scripts/eval.ts"
  },
  "type": "module",
  "dependencies": {
    "baileys": "^7.0.0-rc14",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "typescript": "~5.9"
  },
  "private": true,
  "engines": {
    "node": ">=22.18"
  }
}
